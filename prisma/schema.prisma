// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema 

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  /// R2 object key, e.g. avatars/{userId}/avatar.webp
  avatarStorageKey String?
  avatarUpdatedAt  DateTime?
  /// IANA timezone, e.g. America/New_York
  timezone         String?
  applications     JobApplication[]
  events           ApplicationEvent[]
  reminders        Reminder[]
  interviews       Interview[]
  resumes           Resume[]
  candidateProfiles CandidateProfile[]
  resumeReviews     ResumeReview[]
  usageCounters     UsageCounter[]
  jobMatchResults   JobMatchResult[]
  jobSourceSubmissions JobSourceSubmission[]
  savedJobs         SavedJob[]
  matchAlertPreference MatchAlertPreference?
  subscription      Subscription?
  /// Internal admin console access (Phase V2G). One row per user max.
  adminMembership   AdminMembership?   @relation("AdminMembershipSubject")
  /// Admin memberships this user invited (optional audit linkage).
  adminInvites      AdminMembership[]  @relation("AdminMembershipInvite")
  auditLogsAsActor  AuditLog[]         @relation("AuditLogActor")
  auditLogsAsTarget AuditLog[]         @relation("AuditLogTarget")
  passwordResetTokens PasswordResetToken[]
  calendarIntegrations CalendarIntegration[]
  calendarEvents       CalendarEvent[]
  notifications        Notification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// One-time opaque tokens for password reset emails.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Grants access to `/api/v1/admin/*`. Use with JwtAuthGuard + AdminGuard — never Jwt alone.
enum AdminRole {
  OWNER
  ADMIN
  SUPPORT
  ANALYST
}

enum AdminMembershipStatus {
  ACTIVE
  REVOKED
}

model AdminMembership {
  id            String                   @id @default(uuid())
  userId        String                   @unique
  user          User                     @relation("AdminMembershipSubject", fields: [userId], references: [id], onDelete: Cascade)
  role          AdminRole                @default(ADMIN)
  invitedById   String?
  invitedBy     User?                    @relation("AdminMembershipInvite", fields: [invitedById], references: [id], onDelete: SetNull)
  status        AdminMembershipStatus    @default(ACTIVE)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("admin_memberships")
}

/// Append-only audit trail for admin actions (V2G).
model AuditLog {
  id           String   @id @default(uuid())
  /// Nullable so rows survive rare actor user hard-deletes (`ON DELETE SET NULL`).
  actorUserId  String?
  actorUser    User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("audit_logs")
}

model Resume {
  id                String               @id @default(uuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName           String
  fileType           String
  fileSize           Int
  fileUrl            String?
  storageKey         String               @unique
  status             ResumeParseStatus    @default(UPLOADED)
  parsedText         String?
  parseError         String?
  isActive           Boolean              @default(false)
  candidateProfile   CandidateProfile?
  resumeReviews      ResumeReview[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId])
}

model CandidateProfile {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId             String    @unique
  resume               Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  headline             String?
  summary              String?
  skills               Json?
  tools                Json?
  roles                Json?
  industries           Json?
  yearsOfExperience    Int?
  locations            Json?
  workModes            Json?
  education            Json?
  certifications       Json?
  projects             Json?
  experience           Json?
  rawExtractedData     Json?
  extractionPipeline   String?
  isConfirmed          Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  jobMatchResults      JobMatchResult[]

  @@index([userId])
}

model JobApplication {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle    String
  companyName String
  jobUrl      String?
  location    String?
  workMode    WorkMode          @default(UNSPECIFIED)
  salaryMin   Int?
  salaryMax   Int?
  currency    String?           @default("USD")
  status      ApplicationStatus @default(SAVED)
  source      ApplicationSource @default(OTHER)
  deadline    DateTime?
  notes       String?
  events            ApplicationEvent[]
  reminders         Reminder[]
  interviews        Interview[]
  resumeReviews     ResumeReview[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  convertedFromSavedJobs SavedJob[]

  @@index([userId])
  @@index([status])
  @@index([companyName])
}

model ResumeReview {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String
  resume          Resume             @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobId           String?
  type            ResumeReviewType
  overallScore    Int?
  atsScore        Int?
  keywordScore    Int?
  structureScore  Int?
  clarityScore    Int?
  strengths       Json?
  weaknesses      Json?
  missingKeywords Json?
  suggestions     Json?
  improvedBullets Json?
  summary         String?
  rawAiOutput     Json?
  status          ResumeReviewStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([resumeId])
  @@index([applicationId])
}

model UsageCounter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey  String
  periodKey   String
  count       Int      @default(0)
  limitValue  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, featureKey, periodKey])
  @@index([userId])
}

model ApplicationEvent {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          EventType
  title         String
  description   String?
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([applicationId])
}

model Reminder {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime
  isCompleted   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([dueDate])
}

model Interview {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         InterviewStage
  interviewType InterviewType
  scheduledAt   DateTime
  location      String?
  meetingLink   String?
  notes         String?
  outcome       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([scheduledAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_ASSESSMENT
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNSPECIFIED
}

enum ApplicationSource {
  LINKEDIN
  COMPANY_WEBSITE
  REFERRAL
  INDEED
  TWITTER
  EMAIL
  OTHER
}

enum EventType {
  STATUS_CHANGE
  NOTE
  RECRUITER_UPDATE
  INTERVIEW_UPDATE
  REMINDER_CREATED
  GENERAL_UPDATE
}

enum InterviewStage {
  RECRUITER_SCREEN
  TECHNICAL_INTERVIEW
  TECHNICAL_ASSESSMENT
  HIRING_MANAGER
  FINAL_INTERVIEW
  OFFER_DISCUSSION
  OTHER
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TAKE_HOME
  LIVE_CODING
  OTHER
}

enum ResumeParseStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
  ARCHIVED
}

enum ResumeReviewType {
  GENERAL
  JOB_SPECIFIC
}

enum ResumeReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

/// External job ingestion registry (§5.3 — job_sources)
model JobSource {
  id               String           @id @default(uuid())
  name             String
  type             JobSourceType
  baseUrl          String?
  isActive         Boolean          @default(true)
  requiresApiKey   Boolean          @default(false)
  lastSyncAt       DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  /** Incremented on each failed ingest sync; reset on success (Phase J.3). */
  consecutiveSyncFailures Int @default(0)
  /** Per-ATS opaque settings (board_token, Lever site slug, etc.) — Phase A ingest plan. */
  config           Json?
  externalJobs     ExternalJob[]
  jobSourceSubmissions JobSourceSubmission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([isActive])
}

/// Normalized job posting (§5.3 — external_jobs)
model ExternalJob {
  id              String                       @id @default(uuid())
  sourceId        String
  source          JobSource                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceName      String
  externalJobId   String
  title           String
  company         String
  location        String?
  country         String?
  remoteType      ExternalJobRemoteType        @default(UNSPECIFIED)
  salaryMin       Int?
  salaryMax       Int?
  currency        String?                     @default("USD")
  description     String?
  requirements    String?
  employmentType ExternalJobEmploymentType     @default(UNSPECIFIED)
  experienceLevel ExternalExperienceLevel      @default(UNSPECIFIED)
  applicationUrl  String?
  postedAt        DateTime?
  expiresAt       DateTime?
  rawPayload      Json?
  contentHash     String?
  isActive        Boolean                     @default(true)
  /** Phase J.1 — set by weekly quality scan when apply URL, salary, or duplicate hash issues are detected. */
  isSuspicious    Boolean                     @default(false)
  /** Phase J.1 — machine-readable reasons, e.g. MISSING_APPLICATION_URL, DUPLICATE_CONTENT_HASH. */
  qualityFlags    Json?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  jobMatchResults JobMatchResult[]
  savedJobs       SavedJob[]

  @@unique([sourceId, externalJobId])
  @@index([sourceId])
  @@index([isActive])
  @@index([postedAt])
  @@index([company])
  @@index([contentHash])
  @@index([isSuspicious])
}

enum JobSourceType {
  API
  ATS_FEED
  MANUAL
  SCRAPER_LATER
}

enum ExternalJobRemoteType {
  REMOTE
  HYBRID
  ONSITE
  UNSPECIFIED
}

enum ExternalJobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNSPECIFIED
}

enum ExternalExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
  UNSPECIFIED
}

enum SavedJobStatus {
  SAVED
  DISMISSED
  CONVERTED_TO_APPLICATION
}

/// User bookmarks a normalized ExternalJob listing (PRD §5.3 saved_jobs — V2D).
model SavedJob {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// FK to `ExternalJob.id` (canonical listing UUID from `GET /jobs/:id`).
  jobListingId String
  listing ExternalJob @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  status SavedJobStatus @default(SAVED)
  notes String?
  convertedApplicationId String?
  convertedApplication JobApplication? @relation(fields: [convertedApplicationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobListingId])
  @@index([userId])
  @@index([status, userId])
  @@map("saved_jobs")
}

/// Cached heuristic match between a candidate profile and an external job (Phase M).
model JobMatchResult {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId           String
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  externalJobId      String
  externalJob        ExternalJob      @relation(fields: [externalJobId], references: [id], onDelete: Cascade)
  overallScore       Int
  titleScore         Int
  skillScore         Int
  experienceScore    Int
  locationScore      Int
  recencyScore       Int
  matchedSkills      Json?
  missingSkills      Json?
  matchReason        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, externalJobId])
  @@index([userId, overallScore])
  @@index([candidateProfileId])
}

/// Per-user thresholds and channels for match alerts (V2E); delivery worker not included here.
model MatchAlertPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Master switch for match notifications (email/push/digest — see channels).
  enabled Boolean @default(false)

  /// Minimum JobMatchResult.overallScore (0–100) to include in alerts.
  minMatchScore Int @default(70)

  /// Per-channel opt-in, e.g. `{ "email": true, "push": false }`.
  channels Json?

  /// Last successful notification send (dedupe / digest anchor).
  lastNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("match_alert_preferences")
}

/// Product catalog (V2F).
model Plan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  /// Stored in minor currency units (e.g. cents); null for free tiers.
  priceMonthly   Int?
  currency       String   @default("usd")
  stripePriceId  String?  @unique
  isActive       Boolean  @default(true)
  isBeta         Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions         Subscription[]
  featureEntitlements   FeatureEntitlement[]

  @@map("plans")
}

model FeatureEntitlement {
  id         String   @id @default(uuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  /// Monthly-style quotas when applicable; null = unlimited / not quota-based.
  limitValue Int?
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, featureKey])
  @@index([planId])
  @@map("feature_entitlements")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status               SubscriptionStatus @default(BETA)
  provider             BillingProvider    @default(NONE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  betaStartedAt        DateTime?
  betaEndsAt           DateTime?
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

enum BillingProvider {
  NONE
  STRIPE
}

enum SubscriptionStatus {
  BETA
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum JobSourceSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

/// User-submitted careers page awaiting admin review (Phase I).
model JobSourceSubmission {
  id              String                    @id @default(uuid())
  companyName     String
  careersUrl      String
  submitterEmail  String?
  submitterUserId String?
  submitterUser   User?                     @relation(fields: [submitterUserId], references: [id], onDelete: SetNull)
  detectedAtsType String?
  detectedSlug    String?
  status          JobSourceSubmissionStatus @default(PENDING)
  jobSourceId     String?
  jobSource       JobSource?                @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  reviewerNotes   String?
  submitterIp     String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([careersUrl])
}

enum CalendarProvider {
  GOOGLE
}

enum CalendarEventSourceType {
  INTERVIEW
}

enum CalendarEventSyncStatus {
  SYNCED
  PENDING
  FAILED
}

/// Connected calendar provider (V2I).
model CalendarIntegration {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              CalendarProvider
  providerAccountEmail  String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String
  scope                 String?
  expiresAt             DateTime?
  isActive              Boolean          @default(true)
  autoSyncInterviews    Boolean          @default(true)
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  calendarEvents        CalendarEvent[]

  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_integrations")
}

/// Maps JobTrackr records to external calendar events (V2I).
model CalendarEvent {
  id              String                  @id @default(uuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     CalendarIntegration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  sourceType      CalendarEventSourceType
  sourceId        String
  providerEventId String?
  syncStatus      CalendarEventSyncStatus @default(PENDING)
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([integrationId, sourceType, sourceId])
  @@index([userId])
  @@map("calendar_events")
}

enum NotificationType {
  RESUME_REVIEW_COMPLETED
  JOB_MATCHES_AVAILABLE
  JOB_ALERT_DIGEST
  CALENDAR_SYNC_FAILED
  REMINDER_DUE
  INTERVIEW_UPCOMING
  GENERAL
}

/// In-app notifications (V2J).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
