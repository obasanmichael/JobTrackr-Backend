// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema 

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  applications     JobApplication[]
  events           ApplicationEvent[]
  reminders        Reminder[]
  interviews       Interview[]
  resumes           Resume[]
  candidateProfiles CandidateProfile[]
  resumeReviews     ResumeReview[]
  usageCounters     UsageCounter[]
  jobMatchResults   JobMatchResult[]
  jobSourceSubmissions JobSourceSubmission[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Resume {
  id                String               @id @default(uuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName           String
  fileType           String
  fileSize           Int
  fileUrl            String?
  storageKey         String               @unique
  status             ResumeParseStatus    @default(UPLOADED)
  parsedText         String?
  parseError         String?
  isActive           Boolean              @default(false)
  candidateProfile   CandidateProfile?
  resumeReviews      ResumeReview[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([userId])
}

model CandidateProfile {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId             String    @unique
  resume               Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  headline             String?
  summary              String?
  skills               Json?
  tools                Json?
  roles                Json?
  industries           Json?
  yearsOfExperience    Int?
  locations            Json?
  workModes            Json?
  education            Json?
  certifications       Json?
  projects             Json?
  experience           Json?
  rawExtractedData     Json?
  extractionPipeline   String?
  isConfirmed          Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  jobMatchResults      JobMatchResult[]

  @@index([userId])
}

model JobApplication {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle    String
  companyName String
  jobUrl      String?
  location    String?
  workMode    WorkMode          @default(UNSPECIFIED)
  salaryMin   Int?
  salaryMax   Int?
  currency    String?           @default("USD")
  status      ApplicationStatus @default(SAVED)
  source      ApplicationSource @default(OTHER)
  deadline    DateTime?
  notes       String?
  events            ApplicationEvent[]
  reminders         Reminder[]
  interviews        Interview[]
  resumeReviews     ResumeReview[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([companyName])
}

model ResumeReview {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String
  resume          Resume             @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobId           String?
  type            ResumeReviewType
  overallScore    Int?
  atsScore        Int?
  keywordScore    Int?
  structureScore  Int?
  clarityScore    Int?
  strengths       Json?
  weaknesses      Json?
  missingKeywords Json?
  suggestions     Json?
  improvedBullets Json?
  summary         String?
  rawAiOutput     Json?
  status          ResumeReviewStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([resumeId])
  @@index([applicationId])
}

model UsageCounter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey  String
  periodKey   String
  count       Int      @default(0)
  limitValue  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, featureKey, periodKey])
  @@index([userId])
}

model ApplicationEvent {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          EventType
  title         String
  description   String?
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([applicationId])
}

model Reminder {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime
  isCompleted   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([dueDate])
}

model Interview {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         InterviewStage
  interviewType InterviewType
  scheduledAt   DateTime
  location      String?
  meetingLink   String?
  notes         String?
  outcome       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([scheduledAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL_ASSESSMENT
  FINAL_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNSPECIFIED
}

enum ApplicationSource {
  LINKEDIN
  COMPANY_WEBSITE
  REFERRAL
  INDEED
  TWITTER
  EMAIL
  OTHER
}

enum EventType {
  STATUS_CHANGE
  NOTE
  RECRUITER_UPDATE
  INTERVIEW_UPDATE
  REMINDER_CREATED
  GENERAL_UPDATE
}

enum InterviewStage {
  RECRUITER_SCREEN
  TECHNICAL_INTERVIEW
  TECHNICAL_ASSESSMENT
  HIRING_MANAGER
  FINAL_INTERVIEW
  OFFER_DISCUSSION
  OTHER
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TAKE_HOME
  LIVE_CODING
  OTHER
}

enum ResumeParseStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
  ARCHIVED
}

enum ResumeReviewType {
  GENERAL
  JOB_SPECIFIC
}

enum ResumeReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

/// External job ingestion registry (§5.3 — job_sources)
model JobSource {
  id               String           @id @default(uuid())
  name             String
  type             JobSourceType
  baseUrl          String?
  isActive         Boolean          @default(true)
  requiresApiKey   Boolean          @default(false)
  lastSyncAt       DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  /** Per-ATS opaque settings (board_token, Lever site slug, etc.) — Phase A ingest plan. */
  config           Json?
  externalJobs     ExternalJob[]
  jobSourceSubmissions JobSourceSubmission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([isActive])
}

/// Normalized job posting (§5.3 — external_jobs)
model ExternalJob {
  id              String                       @id @default(uuid())
  sourceId        String
  source          JobSource                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceName      String
  externalJobId   String
  title           String
  company         String
  location        String?
  country         String?
  remoteType      ExternalJobRemoteType        @default(UNSPECIFIED)
  salaryMin       Int?
  salaryMax       Int?
  currency        String?                     @default("USD")
  description     String?
  requirements    String?
  employmentType ExternalJobEmploymentType     @default(UNSPECIFIED)
  experienceLevel ExternalExperienceLevel      @default(UNSPECIFIED)
  applicationUrl  String?
  postedAt        DateTime?
  expiresAt       DateTime?
  rawPayload      Json?
  contentHash     String?
  isActive        Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  jobMatchResults JobMatchResult[]

  @@unique([sourceId, externalJobId])
  @@index([sourceId])
  @@index([isActive])
  @@index([postedAt])
  @@index([company])
  @@index([contentHash])
}

enum JobSourceType {
  API
  ATS_FEED
  MANUAL
  SCRAPER_LATER
}

enum ExternalJobRemoteType {
  REMOTE
  HYBRID
  ONSITE
  UNSPECIFIED
}

enum ExternalJobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNSPECIFIED
}

enum ExternalExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
  UNSPECIFIED
}

/// Cached heuristic match between a candidate profile and an external job (Phase M).
model JobMatchResult {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId           String
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  externalJobId      String
  externalJob        ExternalJob      @relation(fields: [externalJobId], references: [id], onDelete: Cascade)
  overallScore       Int
  titleScore         Int
  skillScore         Int
  experienceScore    Int
  locationScore      Int
  recencyScore       Int
  matchedSkills      Json?
  missingSkills      Json?
  matchReason        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, externalJobId])
  @@index([userId, overallScore])
  @@index([candidateProfileId])
}

enum JobSourceSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

/// User-submitted careers page awaiting admin review (Phase I).
model JobSourceSubmission {
  id              String                    @id @default(uuid())
  companyName     String
  careersUrl      String
  submitterEmail  String?
  submitterUserId String?
  submitterUser   User?                     @relation(fields: [submitterUserId], references: [id], onDelete: SetNull)
  detectedAtsType String?
  detectedSlug    String?
  status          JobSourceSubmissionStatus @default(PENDING)
  jobSourceId     String?
  jobSource       JobSource?                @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  reviewerNotes   String?
  submitterIp     String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([careersUrl])
}
