# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth (JWT) ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# ── HTTP server ────────────────────────────────────────────────────────────
# This Nest app must use a different port than the Next.js dev server.
# Example: Next on http://localhost:3001 → use 4000 (or any free port) here.
PORT=4000

# Rate limiting (global)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Stricter auth route limit (/auth/register + /auth/login)
AUTH_THROTTLE_LIMIT=30

# Stricter match generation limit (/matches/generate)
MATCHES_GENERATE_THROTTLE_LIMIT=10

# Matching engine pool / cache (V2E.E2) — optional overrides
# MATCH_CACHE_TTL_HOURS=24
# MATCH_JOB_POOL_SIZE=250
# MATCH_RESULT_LIMIT=50

# Stricter admin job-source sync limit (/admin/job-sources/*/sync, sync-active)
ADMIN_SYNC_THROTTLE_LIMIT=10

# Stricter public careers page submission limit (/job-source-submissions)
JOB_SOURCE_SUBMISSIONS_THROTTLE_LIMIT=10

NODE_ENV=

# Comma-separated origins allowed to call the API from the browser (CORS).
# Include every URL you use to open the web app (with scheme + host + port).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

FRONTEND_URL=

# ── Billing / Stripe (V2F) — optional; omit until testing subscriptions ─────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# Or generic: STRIPE_PRICE_<PLANCODE> e.g. STRIPE_PRICE_PRO=price_...

# ── AI resume review ─────────────────────────────────────────────────────────
# mock | openai — OpenAI requires OPENAI_API_KEY.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_RESUME_REVIEW_TIMEOUT_MS=60000
# -1 or unlimited = no monthly cap; otherwise max successful reviews per UTC month.
AI_RESUME_REVIEW_MONTHLY_LIMIT=-1

# ── Admin routes (JwtAuthGuard + AdminGuard — never JWT alone) ────────────────
# Access: (1) ACTIVE row in DB table `admin_memberships` for the user, OR
# (2) legacy comma-separated user IDs here (bootstrap / local only).
# Example: ADMIN_USER_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ADMIN_USER_IDS=

# ── Trust & quality (Phase J) ───────────────────────────────────────────────
# Max salary (USD) before a listing is flagged as SALARY_OUTLIER during scan.
JOB_QUALITY_SALARY_MAX_USD=500000
# Log job_source_sync_alert after this many consecutive sync failures per source.
JOB_SOURCE_CONSECUTIVE_FAILURE_ALERT_THRESHOLD=3
# Purge inactive external jobs older than this many days (requires purge enabled).
EXTERNAL_JOB_INACTIVE_RETENTION_DAYS=90
# Set true/1/yes to allow POST /admin/job-quality/purge-inactive and CLI purge.
EXTERNAL_JOB_PURGE_ENABLED=false

# ── Avatar storage (Cloudflare R2) — optional until profile avatars are enabled ─
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=jobtrackr-avatars
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── Password reset email (optional SMTP; logs to console in dev when unset) ───
# PASSWORD_RESET_TTL_HOURS=1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=JobTrackr <noreply@jobtrackr.app>

# ── Token encryption (required) ───────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Google Calendar OAuth (V2I) — optional until calendar sync is enabled ─────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/v1/calendar/google/callback
# FRONTEND_URL is required when Google Calendar vars are set (OAuth redirect target).

# ── Scheduled notifications (cron-job.org or any HTTP cron — V2J) ───────────
# POST /api/v1/internal/cron/notifications/run-due-checks
# Header: Authorization: Bearer <CRON_SECRET>  (schedule: every 5 minutes)
# Alternative header: X-Cron-Secret: <CRON_SECRET>
# NOTIFICATION_WORKER_ENABLED=true
# CRON_SECRET=
